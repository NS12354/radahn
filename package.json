{
  "name": "formframe",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware prototyping studio: 3D product form + on-device UI + interactions + emulated electronics + real firmware, in one canvas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "compile:ino": "node server/compile.mjs",
    "setup:toolchain": "bash scripts/setup-toolchain.sh",
    "build:examples": "tsx scripts/build-examples.ts",
    "build:micropython": "bash scripts/build-micropython.sh",
    "vendor": "node scripts/copy-vendor.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs",
    "pretest": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "avr8js": "^0.21.1",
    "occt-import-js": "^0.0.23",
    "rp2040js": "^1.4.1",
    "skulpt": "^1.2.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.160.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
