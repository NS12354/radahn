# Copy to .env and fill in. .env is git-ignored.

# Claude reads product pages for "Add from a link" (optional; without it a rough parser is used).
ANTHROPIC_API_KEY=

# Path to the Blender executable for the live link (optional; /Applications/Blender.app is found automatically).
BLENDER_PATH=

# GitHub tab "Sign in with GitHub" (optional; without it, sign in with a personal access token).
# Create an OAuth App at github.com/settings/developers, tick "Enable Device Flow", paste its Client ID.
GITHUB_CLIENT_ID=

# Accounts: save projects and scenes to a Supabase account (optional; without them accounts are off).
# Project Settings > API in the Supabase dashboard. Both are public; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
